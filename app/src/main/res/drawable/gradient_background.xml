<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Metallic Circuit Dark Base (#02080D) -->
    <item>
        <color android:color="#02080D"/>
    </item>

    <!-- 2. Fine Linear Shading Gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#13ffF2FF"
                android:endColor="#01080D"/>
        </shape>
    </item>

    <!-- 3. Top Central Cyan Circuit Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:centerX="50%"
                android:centerY="0%"
                android:startColor="#7100F2FF"
                android:centerColor="#2f00A8B3"
                android:endColor="#a002080D"/>
        </shape>
    </item>

    <!-- 4. Bottom-Left Cyan Accent Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="600dp"
                android:centerX="0%"
                android:centerY="100%"
                android:startColor="#1f00F2FF"
                android:endColor="#1B02080D"/>
        </shape>
    </item>

    <!-- 5. Bottom-Right Cyan Accent Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="620dp"
                android:centerX="100%"
                android:centerY="100%"
                android:startColor="#1f00F2FF"
                android:endColor="#1002080D"/>
        </shape>
    </item>
</layer-list>
