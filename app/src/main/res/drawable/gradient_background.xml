<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Metallic Circuit Dark Base (#02080D) -->
    <item>
        <color android:color="#02080D"/>
    </item>

    <!-- 2. Fine Linear Shading Gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#0B00F2FF"
                android:endColor="#02080D"/>
        </shape>
    </item>

    <!-- 3. Top Central Cyan Circuit Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="500dp"
                android:centerX="50%"
                android:centerY="0%"
                android:startColor="#1200F2FF"
                android:centerColor="#2B00A8B3"
                android:endColor="#0002080D"/>
        </shape>
    </item>

    <!-- 4. Bottom-Left Cyan Accent Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:centerX="0%"
                android:centerY="100%"
                android:startColor="#1700F2FF"
                android:endColor="#2B02080D"/>
        </shape>
    </item>

    <!-- 5. Bottom-Right Cyan Accent Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:centerX="100%"
                android:centerY="100%"
                android:startColor="#1700F2FF"
                android:endColor="#0002080D"/>
        </shape>
    </item>
</layer-list>
