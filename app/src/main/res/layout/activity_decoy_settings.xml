<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#313131"
    android:orientation="vertical">

    <TextView
        android:id="@+id/settingsTitle"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="80dp"
        android:fontFamily="sans-serif"
        android:padding="24dp"
        android:text="Stability Settings"
        android:textColor="#F2EDED"
        android:textSize="35sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Fake iOS-style settings list -->
            <TextView
                style="@style/SettingsHeader"
                android:layout_height="25dp"
                android:text="SYSTEM (Unavailable)"
                android:textAllCaps="false"
                android:textColor="#CCC7C7" />

            <LinearLayout style="@style/SettingsGroup">

                <TextView
                    style="@style/SettingsItem"
                    android:text="General"
                    android:textColor="#9E9D9D" />

                <View style="@style/SettingsDivider" />

                <TextView
                    style="@style/SettingsItem"
                    android:text="Display &amp; Brightness"
                    android:textColor="#A0A0A0" />

                <View style="@style/SettingsDivider" />

                <TextView
                    style="@style/SettingsItem"
                    android:text="Accessibility"
                    android:textColor="#A4A3A3" />
            </LinearLayout>

            <TextView
                style="@style/SettingsHeader"
                android:layout_height="26dp"
                android:text="PRIVACY &amp; SECURITY (Unavailable)"
                android:textAllCaps="false"
                android:textColor="#D1CFCF" />

            <LinearLayout style="@style/SettingsGroup">

                <TextView
                    style="@style/SettingsItem"
                    android:text="Privacy"
                    android:textColor="#A6A6A6" />

                <View style="@style/SettingsDivider" />

                <TextView
                    style="@style/SettingsItem"
                    android:text="Security"
                    android:textColor="#9D9D9D" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
