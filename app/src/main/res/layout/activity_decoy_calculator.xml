<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="20dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/calcDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:gravity="bottom|end"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="80sp"
        android:padding="10dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="sans-serif-light" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="415dp"
        android:layout_marginBottom="40dp"
        android:columnCount="4"
        android:rowCount="5"
        android:useDefaultMargins="false">

        <!-- Row 1 -->
        <Button
            style="@style/CalcBtn"
            android:backgroundTint="@color/system_gray"
            android:text="C"
            android:textColor="@color/neon_red" />

        <Button
            style="@style/CalcBtn"
            android:backgroundTint="@color/system_gray"
            android:text="+/-"
            android:textColor="#000" />

        <Button
            style="@style/CalcBtn"
            android:backgroundTint="@color/system_gray"
            android:text="%"
            android:textColor="#000" />

        <Button
            style="@style/CalcBtn"
            android:backgroundTint="@color/blue_sky"
            android:text="/" />

        <!-- Row 2 -->
        <Button
            style="@style/CalcBtn"
            android:backgroundTint="#333333"
            android:text="7" />

        <Button
            style="@style/CalcBtn"
            android:backgroundTint="#333333"
            android:text="8" />

        <Button
            style="@style/CalcBtn"
            android:backgroundTint="#333333"
            android:text="9" />

        <Button
            style="@style/CalcBtn"
            android:backgroundTint="@color/blue_sky"
            android:text="x" />

        <!-- Row 3 -->
        <Button
            style="@style/CalcBtn"
            android:backgroundTint="#333333"
            android:text="4" />

        <Button
            style="@style/CalcBtn"
            android:backgroundTint="#333333"
            android:text="5" />

        <Button
            style="@style/CalcBtn"
            android:backgroundTint="#333333"
            android:text="6" />

        <Button
            style="@style/CalcBtn"
            android:backgroundTint="@color/blue_sky"
            android:text="–" />

        <!-- Row 4 -->
        <Button
            style="@style/CalcBtn"
            android:backgroundTint="#333333"
            android:text="1" />

        <Button
            style="@style/CalcBtn"
            android:backgroundTint="#333333"
            android:text="2" />

        <Button
            style="@style/CalcBtn"
            android:backgroundTint="#333333"
            android:text="3" />

        <Button
            style="@style/CalcBtn"
            android:backgroundTint="@color/blue_sky"
            android:text="+" />

        <!-- Row 5 -->
        <Button
            style="@style/CalcBtn"
            android:layout_columnSpan="2"
            android:layout_gravity="fill_horizontal"
            android:backgroundTint="#333333"
            android:text="0" />

        <Button
            style="@style/CalcBtn"
            android:backgroundTint="#333333"
            android:text="." />

        <Button
            style="@style/CalcBtn"
            android:backgroundTint="@color/neon_red"
            android:text="=" />

    </GridLayout>

</LinearLayout>
