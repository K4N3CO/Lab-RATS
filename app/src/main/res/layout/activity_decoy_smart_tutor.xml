<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp">

    <!-- Top Title: Smart Tutor -->
    <TextView
        android:id="@+id/tvSmartTutorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="12dp"
        android:text="Smart Tutor"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <!-- Hero Card Illustration -->
    <RelativeLayout
        android:id="@+id/cardIllustration"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_below="@id/tvSmartTutorTitle"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_smart_tutor_card"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Phone Graphic -->
            <View
                android:layout_width="42dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_smart_tutor_phone" />

            <!-- Blue Connecting Dots -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" •  •  • "
                android:textColor="#0072CE"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp" />

            <!-- Laptop Graphic -->
            <RelativeLayout
                android:layout_width="130dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_smart_tutor_laptop">

                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/smarttutor_icon" />
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Instruction Text -->
    <TextView
        android:id="@+id/tvSmartTutorNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardIllustration"
        android:layout_marginTop="32dp"
        android:text="Not allowed to access.\nTo allow remote control of your device, touch the below button and follow the steps."
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:lineSpacingExtra="6dp" />

    <!-- Bottom Action Button: Authority mode -->
    <Button
        android:id="@+id/btnSmartTutorConnect"
        android:layout_width="270dp"
        android:layout_height="63dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_smart_tutor_button"
        android:gravity="clip_horizontal|center"
        android:text="Authority mode"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:backgroundTint="@null"
        app:rippleColor="#4B4646" />

</RelativeLayout>
