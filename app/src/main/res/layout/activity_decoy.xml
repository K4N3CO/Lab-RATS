<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090909">

    <LinearLayout
        android:layout_width="391dp"
        android:layout_height="414dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        app:layout_constraintBottom_toTopOf="@+id/btnCheckUpdate"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.514"
        tools:layout_editor_absoluteX="10dp">

        <ImageView
            android:id="@+id/ivUpdateIcon"
            android:layout_width="122dp"
            android:layout_height="115dp"
            android:layout_marginBottom="6dp"
            android:contentDescription="System Update Icon"
            android:src="@drawable/ic_analytics_data"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="95dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/orbitron"
            android:text="@string/decoy_title"
            android:textAlignment="center"
            android:textColor="#E6E6E6"
            android:textSize="31sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:fontFamily="@font/aldrich"
            android:text="@string/decoy_version"
            android:textColor="#B6B6B6"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:fontFamily="@font/aldrich"
            android:text="@string/decoy_security_patch"
            android:textColor="#B6B6B6"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/decoyProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:indeterminate="true"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/pseudoToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:background="@drawable/toast_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/btnCheckUpdate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Toast Icon"
            android:src="@drawable/ic_analytics_data"
            app:tint="@color/decoy_icon_tint" />

        <TextView
            android:id="@+id/pseudoToastText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/decoy_no_updates"
            android:textColor="@color/decoy_background"
            android:textSize="14sp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnCheckUpdate"
        android:layout_width="229dp"
        android:layout_height="50dp"
        android:layout_marginBottom="56dp"
        android:backgroundTint="#278CDE"
        android:fontFamily="@font/assistant"
        android:text="@string/decoy_check_btn"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
