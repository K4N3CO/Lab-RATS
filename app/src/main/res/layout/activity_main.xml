<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3C084008"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="13dp">

            <!-- Header -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="259dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="14dp"
                android:background="#F6070707"
                android:gravity="bottom|center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="184dp"
                    android:layout_height="154dp"
                    android:layout_gravity="center"
                    android:tint="#01E5EBE5"
                    app:srcCompat="@drawable/app_logo" />

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="262dp"
                    android:layout_height="42dp"
                    android:fontFamily="@font/orbitron"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:text="Lab-RATS"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="#FC3DEDF6"
                    android:textSize="37sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDevelopedBy"
                    android:layout_width="wrap_content"
                    android:layout_height="19dp"
                    android:alpha="0.9"
                    android:fontFamily="@font/aldrich"
                    android:letterSpacing="0.2"
                    android:text="DEVELOPED BY K4N3CO.LABS"
                    android:textAllCaps="true"
                    android:textColor="#FC00F2FF"
                    android:textSize="13sp"
                    tools:ignore="TextSizeCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="27dp"
                    android:alpha="0.9"
                    android:fontFamily="@font/aldrich"
                    android:letterSpacing="0.2"
                    android:text="v1.5.1"
                    android:textColor="@color/neon_cyan"
                    android:textSize="13sp" />

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:alpha="1"
                        android:background="#C900F2FF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="213dp"
                        android:background="#F6040404"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="20dp"
                            android:fontFamily="@font/orbitron"
                            android:letterSpacing="0.15"
                            android:text="🔴 SERVER_OFFLINE"
                            android:textColor="@color/neon_red"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="17dp"
                            android:background="#AF474D49" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="14dp"
                            android:alpha="0.7"
                            android:fontFamily="@font/aldrich"
                            android:letterSpacing="0.2"
                            android:text="VIRTUAL_UPLINK_INFO:"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvIpAddress"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:alpha="0.9"
                            android:background="#363F7147"
                            android:fontFamily="@font/aldrich"
                            android:gravity="center_vertical"
                            android:minHeight="34dp"
                            android:text=" [LOADING_DATA...]"
                            android:textColor="@color/neon_cyan"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="116dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="14dp"
                            android:alpha="0.7"
                            android:fontFamily="@font/aldrich"
                            android:letterSpacing="0.2"
                            android:text="REMOTE_C2_LINK"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvServerUrl"
                            android:layout_width="match_parent"
                            android:layout_height="41dp"
                            android:layout_marginTop="4dp"
                            android:background="#3843784D"
                            android:fontFamily="@font/assistant"
                            android:gravity="center_vertical"
                            android:padding="6dp"
                            android:text="UPLINK_INACTIVE"
                            android:textColor="@color/neon_cyan"
                            android:textSize="15sp" />

                    </LinearLayout>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartStop"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:layout_marginBottom="11dp"
                android:backgroundTint="#EA00F2FF"
                android:fontFamily="@font/orbitron"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.15"
                android:paddingTop="2dp"
                android:text="INITIALIZE_SERVER"
                android:textColor="@color/bg_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyUrl"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/orbitron"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.15"
                android:text="COPY_LINK"
                android:textColor="@color/neon_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/neon_cyan"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBatteryOptimization"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/orbitron"
                android:gravity="bottom|center"
                android:letterSpacing="0.15"
                android:text="BYPASS_POWER_LIMITS"
                android:textColor="@color/neon_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginTop="55dp"
                android:layout_marginBottom="40dp"
                android:background="#B8050505"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvTerminalFeedback"
                    android:layout_width="278dp"
                    android:layout_height="36dp"
                    android:alpha="0.9"
                    android:fontFamily="@font/aldrich"
                    android:gravity="center|fill_vertical"
                    android:letterSpacing="0.07"
                    android:text="[ SECURE CONNECTION ESTABLISHED ]"
                    android:textColor="@color/neon_cyan"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
