<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4C073507"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="13dp">

            <!-- Header -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="14dp"
                android:background="#040404"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="20dp">

                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="160dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    android:tint="#01E5EBE5"
                    app:srcCompat="@drawable/app_logo" />

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/orbitron"
                    android:letterSpacing="0.05"
                    android:text="LAB-RATS"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="#FC3DEDF6"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDevelopedBy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.9"
                    android:fontFamily="@font/aldrich"
                    android:letterSpacing="0.12"
                    android:text="DEVELOPED BY K4N3CO.LABS"
                    android:textAllCaps="true"
                    android:textColor="#FC00F2FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:ignore="TextSizeCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.9"
                    android:fontFamily="@font/aldrich"
                    android:letterSpacing="0.2"
                    android:text="v1.5.1"
                    android:textColor="@color/neon_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:alpha="1"
                        android:background="#C900F2FF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#040404"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginBottom="13dp"
                            android:fontFamily="@font/orbitron"
                            android:letterSpacing="0.15"
                            android:text="🔴 SERVER_OFFLINE"
                            android:textColor="@color/neon_red"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="15dp"
                            android:background="#AF474D49" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.7"
                            android:fontFamily="@font/aldrich"
                            android:letterSpacing="0.2"
                            android:text="VIRTUAL_UPLINK_INFO:"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvIpAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.9"
                            android:background="#4E084008"
                            android:fontFamily="@font/aldrich"
                            android:gravity="center_vertical"
                            android:letterSpacing="0.05"
                            android:minHeight="34dp"
                            android:paddingStart="8dp"
                            android:text="[LOADING_DATA...]"
                            android:textColor="@color/neon_cyan"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:alpha="0.7"
                            android:fontFamily="@font/aldrich"
                            android:letterSpacing="0.2"
                            android:text="REMOTE_C2_LINK"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvServerUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="#4E084008"
                            android:fontFamily="@font/assistant"
                            android:gravity="center_vertical"
                            android:minHeight="38dp"
                            android:padding="6dp"
                            android:text="UPLINK_INACTIVE"
                            android:textColor="@color/neon_cyan"
                            android:textSize="14sp" />

                    </LinearLayout>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartStop"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:layout_marginBottom="11dp"
                android:backgroundTint="#EA00F2FF"
                android:fontFamily="@font/orbitron"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.15"
                android:paddingTop="2dp"
                android:text="INITIALIZE_SERVER"
                android:textColor="@color/bg_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyUrl"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/orbitron"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.15"
                android:text="COPY_LINK"
                android:textColor="@color/neon_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/neon_cyan"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBatteryOptimization"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/orbitron"
                android:gravity="bottom|center"
                android:letterSpacing="0.15"
                android:text=" BYPASS_POWER_LIMITS"
                android:textColor="@color/neon_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginTop="55dp"
                android:layout_marginBottom="40dp"
                android:background="#000000"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvTerminalFeedback"
                    android:layout_width="278dp"
                    android:layout_height="36dp"
                    android:alpha="0.8"
                    android:fontFamily="@font/aldrich"
                    android:gravity="center|fill_vertical"
                    android:letterSpacing="0.07"
                    android:text="[ SECURE CONNECTION ESTABLISHED ]"
                    android:textColor="@color/neon_cyan"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
