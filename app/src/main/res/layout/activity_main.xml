<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="245dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="18dp"
                android:gravity="bottom|center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="246dp"
                    android:layout_height="137dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/app_logo" />

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="267dp"
                    android:layout_height="48dp"
                    android:fontFamily="@font/orbitron"
                    android:gravity="center"
                    android:letterSpacing="0.25"
                    android:text="Lab-RATS"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="@color/neon_cyan"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDevelopedBy"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginTop="4dp"
                    android:alpha="0.7"
                    android:fontFamily="@font/aldrich"
                    android:letterSpacing="0.2"
                    android:text="DEVELOPED BY K4N3CO.LABS"
                    android:textAllCaps="true"
                    android:textColor="@color/neon_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="4dp"
                    android:alpha="0.7"
                    android:fontFamily="@font/aldrich"
                    android:letterSpacing="0.2"
                    android:text="v1.5.1"
                    android:textColor="@color/neon_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:background="@color/neon_cyan" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="211dp"
                        android:orientation="vertical"
                        android:padding="11dp">

                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginBottom="16dp"
                            android:fontFamily="@font/orbitron"
                            android:letterSpacing="0.15"
                            android:text="🔴 SERVER_OFFLINE"
                            android:textColor="@color/neon_red"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="16dp"
                            android:background="#1affffff" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="14dp"
                            android:alpha="0.9"
                            android:fontFamily="@font/aldrich"
                            android:letterSpacing="0.2"
                            android:text="VIRTUAL_UPLINK_INFO"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvIpAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/aldrich"
                            android:minHeight="34dp"
                            android:text="[LOADING_DATA...]"
                            android:textColor="@color/neon_cyan"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="12dp"
                            android:layout_marginTop="16dp"
                            android:alpha="0.9"
                            android:fontFamily="@font/aldrich"
                            android:letterSpacing="0.2"
                            android:text="REMOTE_C2_LINK"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvServerUrl"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="8dp"
                            android:background="#0D00f2ff"
                            android:fontFamily="sans-serif"
                            android:padding="12dp"
                            android:text="UPLINK_INACTIVE"
                            android:textColor="@color/neon_cyan"
                            android:textSize="13sp" />

                    </LinearLayout>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartStop"
                android:layout_width="match_parent"
                android:layout_height="51dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/neon_cyan"
                android:fontFamily="@font/orbitron"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.15"
                android:text="INITIALIZE_SERVER"
                android:textColor="@color/bg_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyUrl"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/orbitron"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.15"
                android:text="COPY_LINK"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/neon_cyan"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBatteryOptimization"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/orbitron"
                android:gravity="bottom|center"
                android:letterSpacing="0.15"
                android:text="BYPASS_POWER_LIMITS"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="40dp"
                android:background="@color/black"
                android:gravity="bottom|center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvTerminalFeedback"
                    android:layout_width="239dp"
                    android:layout_height="41dp"
                    android:fontFamily="@font/aldrich"
                    android:gravity="center"
                    android:text="[ SECURE CONNECTION ESTABLISHED ]"
                    android:textColor="@color/neon_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
